# ---- Hosted app only ----
# Password for the deployed app (HTTP Basic Auth, any username). Not needed for npm run dev.
# KATHA_PASSWORD=

# ---- Script + storyboard brain (required) ----
# Which provider writes the episode scripts: anthropic | azure
SCRIPT_PROVIDER=anthropic

# -- Anthropic --
ANTHROPIC_API_KEY=sk-ant-...
KATHA_SCRIPT_MODEL=claude-opus-5

# -- Azure OpenAI / AI Foundry --
# Resource host OR a full AI Foundry project URL; only the origin is used.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=...
# The DEPLOYMENT name from your Azure resource, not the model family name.
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# Which Azure surface: responses (default, newer models) | chat
AZURE_OPENAI_API_STYLE=responses
AZURE_OPENAI_API_VERSION=preview

# Output ceiling per script call. A full episode needs ~12-16k.
SCRIPT_MAX_TOKENS=16000

# ---- Hindi narration (required for voice) ----
ELEVENLABS_API_KEY=...
# Adults: Niraj (male Hindi narrator). Kids: Monika Sogam (warmer female Hindi).
ELEVENLABS_VOICE_ID=zgqefOY5FPQ3bB7OZTVR
ELEVENLABS_VOICE_ID_KIDS=1qEiC6qsybMkmnNdVMbK
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Still-image visuals (pick ONE provider) ----
# provider = gemini | openai | fal | none
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=...
# gemini-3-pro-image (best prompt fidelity) | gemini-3.1-flash-image (cheaper/faster)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# 1K | 2K | 4K. 2K = 1536x2752, the right source size for the Ken Burns zoom.
GEMINI_IMAGE_SIZE=2K
OPENAI_API_KEY=...
OPENAI_IMAGE_MODEL=gpt-image-1
FAL_KEY=...
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra

# ---- Veo motion shots (optional, used only on shots flagged `motion`) ----
VEO_ENABLED=false
VEO_MODEL=veo-3.1-generate-preview
# Veo returns 720x1280 by default. Uncomment to request higher (untested on this key).
# VEO_RESOLUTION=1080p
